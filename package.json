{
  "name": "shared-tour-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run api\" \"npm run web\"",
    "api": "node server/app.js",
    "web": "vite --host 0.0.0.0 --port 5173",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:seed-users": "node server/db/seed-users.js",
    "db:reset": "node server/db/migrate.js && node server/db/seed.js && node server/db/seed-users.js",
    "db:sanitize-html": "node server/db/sanitize-existing-html.js",
    "job:cancel-unconfirmed": "node server/jobs/cancel-unconfirmed.js",
    "check:node": "node scripts/check-node.js",
    "test": "node scripts/run-tests.js",
    "build": "node scripts/sync-constants.js && vite build",
    "start": "node server/app.js",
    "preview": "vite preview --host 0.0.0.0",
    "sync:partials": "node scripts/sync-partials.js",
    "sync:constants": "node scripts/sync-constants.js",
    "check:constants": "node scripts/sync-constants.js --check",
    "smoke": "node scripts/smoke-routes.js",
    "check:status-literals": "node scripts/check-status-literals.js",
    "check:catch-handlers": "node scripts/check-catch-handlers.js",
    "check:applied-schema": "node scripts/check-applied-schema.js",
    "sync:rules": "node scripts/sync-departure-rules.js",
    "check:rules": "node scripts/sync-departure-rules.js --check",
    "rehearse:cancel-job": "bash scripts/rehearse-cancel-job.sh",
    "audit:claims": "node scripts/audit-claims.js",
    "preflight": "npm run check:node && npm run check:constants && npm run check:status-literals && npm run check:catch-handlers && npm run check:rules && npm run check:applied-schema && npm run audit:repo-truth && npm test && npm run smoke && npm run audit:claims",
    "audit:repo-truth": "node scripts/audit-repo-truth.js",
    "test:integration": "node --test server/seo-sitemap.integration.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.5",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "playwright-core": "^1.60.0"
  }
}
