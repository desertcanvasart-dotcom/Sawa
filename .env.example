# Copy to .env and fill in. Never commit the real .env.

# ---- Database (Supabase session pooler URI) --------------------------------
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# X1 — the connection the audit tooling uses. Optional: without it the
# auditors use DATABASE_URL with default_transaction_read_only=on, which
# already refuses writes. Set this to a role that cannot write at all —
# see docs/audit/readonly-credentials.md for the GRANT statements.
DATABASE_URL_READONLY=
PGSSL=true
# S07 — verify the database's certificate. Paste Supabase's CA certificate
# (Project Settings → Database → SSL configuration → Download certificate) as
# PEM text; one line with \n escapes is fine. Test it FIRST, before setting it
# in Railway:  DATABASE_URL=… PGSSL_CA="$(cat prod-ca-2021.crt)" npm run check:db-tls
# Unset = encrypted but not verified (the previous behaviour).
# PGSSL_CA=

# ---- Supabase Auth ---------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Frontend (Vite; must be present at BUILD time, not just runtime) ------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Only needed if the API lives on a different origin than the SPA. In production
# the same Express process serves both, so leave this unset.
# VITE_API_BASE=http://localhost:8787/api

# ---- Server ----------------------------------------------------------------
NODE_ENV=development
API_PORT=8787
# PORT is provided by Railway and wins over API_PORT when set.

# Number of proxy hops in front of the app. Railway terminates TLS at one proxy,
# so production needs "1" — without it every visitor shares a single rate-limit
# bucket. Defaults to 1 when NODE_ENV=production, "false" otherwise (local dev
# has no proxy). Set explicitly if you add a CDN or a second load balancer.
# TRUST_PROXY=1

# Collapse www onto the apex with a 301. Set to the bare apex host in
# production; leave unset locally and on preview deploys so nothing redirects.
# Requires www to be a custom domain on the host too, or www has no TLS cert.
# CANONICAL_HOST=sawatours.org

# Comma-separated browser origins allowed to call the API. Only needed when the
# SPA is served from a different origin than the API; defaults to
# http://localhost:5173.
# CORS_ORIGINS=https://sawatours.com,https://www.sawatours.com

# ---- Email -----------------------------------------------------------------
# Without RESEND_API_KEY the app runs in "log" mode: emails go to the console
# and the email_log table, and account invites fall back to the temp password
# shown in the dashboard.
# RESEND_API_KEY=re_...
# The sender must be on a domain verified in Resend (sawa.tours).
# EMAIL_FROM=Sawa Tours <hello@sawa.tours>

# ---- Phone verification (S04) -----------------------------------------------
# Direct travellers confirm their mobile with a one-time code (SMS or WhatsApp)
# before a seat is held, sent and checked by Twilio Verify. With any of these
# three unset it is OFF and bookings work without it. The Verify Service SID
# starts with VA and is created under Twilio Console → Verify → Services.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=VA...
# Optional: keeps phone-confirmation tokens valid across restarts. Any long
# random string; without it a restart only means asking for a new code.
# PHONE_TOKEN_SECRET=

# Cloudflare Turnstile, the bot check on the public booking forms (see
# docs/ops/stop-fake-bookings.md). Both unset: no check, a warning in the log.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Direct bookings wait for the traveler's email confirmation (migration 058).
# "off" makes them at once, as before. Booking attempts per address per hour.
# BOOKING_EMAIL_CONFIRMATION=on
# BOOKING_RATE_LIMIT_PER_HOUR=5

# Public base URL used for the sign-in and tour links inside emails. REQUIRED in
# production — the default sends agency owners a localhost link they can't open.
APP_URL=http://localhost:5173

# ---- Scheduled cancel job --------------------------------------------------
# The unattended tick is DRY BY DEFAULT: it logs what it would cancel and email,
# and does neither. This is the only path that mails a traveller with no human
# action, and a live run cannot be taken back, so going live is an explicit act.
#   CANCEL_JOB_DRY_RUN=0   cancel and email for real
#   unset / anything else  log only
# Revert to live once the cancellation copy is settled and seeded data has been
# through at least one tick. /api/modes reports cancelJob: live|dry-run|off.
# CANCEL_JOB_DRY_RUN=0

# ---- Autoura departure mirror (optional) -----------------------------------
# All three must be set to enable the sync; absent = cleanly disabled.
# AUTOURA_SYNC_URL=https://getautoura.net/api/webhooks/departures
# AUTOURA_CAPACITY_URL=https://getautoura.net/api/integrations/capacity
# AUTOURA_SYNC_SECRET=shared-hmac-secret
# AUTOURA_BRAND_KEY=sawa-tours

# The /contact form also files each message as a lead in Autoura
# (server/autoura-lead.js), signed with the CONCIERGE webhook's secret — not
# AUTOURA_SYNC_SECRET. Unset → the form still emails hello@, the lead is skipped.
# AUTOURA_LEAD_WEBHOOK_URL=https://getautoura.net/api/webhooks/website-lead
# AUTOURA_WEBHOOK_SECRET=
# Contact-form messages allowed per address per 15 minutes (default 5).
# CONTACT_RATE_LIMIT=5

# ---- Seed / maintenance scripts only ---------------------------------------
# Password given to the accounts created by `npm run db:seed-users`.
# SEED_PASSWORD=Sawa!2026

# DIR-20 — where the payment-link alert goes, and whether it sends.
# DRY by default: the queue is derived from history, so a first live tick
# alerts about every departure ever confirmed, in one burst.
GOAHEAD_ALERT_TO=
GOAHEAD_ALERT_DRY_RUN=1

# ---- Content Security Policy (S06) ------------------------------------------
# The policy ships REPORT-ONLY: browsers block nothing and report what they
# would have blocked to /api/csp-report, logged as "[csp] …" lines. When those
# logs have been quiet on the live site for a few days, set this to enforce it.
# CSP_ENFORCE=true

# Performance (server/supabase.js, server/request-timing.js). Seconds a confirmed
# sign-in token is remembered (0 = ask Supabase on every request); and the
# request time, in ms, above which a request is logged as [slow].
AUTH_CACHE_SECONDS=60
REQUEST_SLOW_MS=1000

# 064 — the automatic EUR/EGP rate (server/fx.js). The daily job fetches the
# market rate into Finance's rate table; sources are tried in this order
# (default: frankfurter-cbe,exchangerate-api — no keys needed). Set
# FX_FETCH_DISABLED=1 to stop the fetch (rates can still be entered by hand).
# FX_PROVIDERS=frankfurter-cbe,exchangerate-api
# FX_FETCH_DISABLED=

# ---- Read by the code, undocumented here until the review of 12 Nov 2026 ----
# Each line shows the value the code falls back to when the variable is unset.

# Feature flags, comma-separated (server/features.js). catalogue_v2 turns on the
# catalogue, numbered departures and pay-at-GoAhead on the public site.
# FEATURES=catalogue_v2

# Database (server/db/index.js). How long a request waits for a connection
# before failing (ms). A statement timeout is sent to Postgres at connect: a
# transaction-mode pooler may refuse it, so test it against the production
# connection string first, and leave it unset for `npm run db:migrate`.
# PG_CONNECT_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=

# Payments (server/payment-providers/index.js). Default: the manual Tab provider.
# PAYMENT_PROVIDER=

# Email. Reply-To on every email (default: the brand address), and where
# operations notices go (default: GOAHEAD_ALERT_TO, then EMAIL_REPLY_TO).
# EMAIL_REPLY_TO=
# OPS_NOTIFY_TO=

# The agency id direct travelers' dates are operated by (server/brand.js).
# Unset: a direct date names no operator ("a licensed Sawa partner").
# DIRECT_BOOKINGS_OPERATOR=

# Salt for the device hash kept with a booking's integrity signals
# (server/booking-signals.js). Set a private value in production: the default
# is in the source code.
# BOOKING_SIGNAL_SALT=

# Old hostnames, comma-separated, that 301 to CANONICAL_HOST (server/canonical.js).
# LEGACY_HOSTS=

# Tour dates and deadlines are worked out in this timezone (server/tz.js).
# TOUR_TIMEZONE=Africa/Cairo

# Background jobs (server/jobs/scheduler.js). They run in production only;
# ENABLE_JOB_SCHEDULER=1 runs them elsewhere, DISABLE_JOB_SCHEDULER=1 stops
# them everywhere (set it on every instance but one if you ever run two).
# The first run of each job is staggered from this delay (ms).
# ENABLE_JOB_SCHEDULER=
# DISABLE_JOB_SCHEDULER=
# JOB_FIRST_RUN_DELAY_MS=60000
# GoAhead emails to travelers are DRY unless this is 0.
# GOAHEAD_NOTIFY_DRY_RUN=1

# The daily claims audit: the site it reads (default APP_URL) and who is
# emailed when it regresses (default EMAIL_REPLY_TO).
# AUDIT_WATCH_BASE=
# AUDIT_ALERT_TO=

# Page cache warm-up (server/app.js): how often (ms; 0 = off) and how many routes.
# PAGE_WARM_INTERVAL_MS=45000
# PAGE_WARM_LIMIT=60

# Tooling only, never needed by the running site:
#   TEST_DATABASE_URL    a disposable Postgres for *.integration.test.js
#   PRODUCTION_DB_HOST   the host check:applied-schema expects to be reading
#   SMOKE_TOKEN          a staff token for `npm run smoke` on signed-in routes
#   ALLOW_SEED_USERS=yes lets db:seed-users run with NODE_ENV=production
